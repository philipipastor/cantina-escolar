# Copie para .env. O banco de desenvolvimento é o do docker-compose.yml.
PORT=3333
DATABASE_URL="postgresql://cantina:cantina_dev@localhost:5433/cantina"
WEB_ORIGIN="http://localhost:5173"

# Use um valor longo e aleatório.
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# Número de proxies à frente da API em produção (0 em desenvolvimento).
TRUST_PROXY=0

# Senha inicial dos usuários criados por `npm run seed`. Só para desenvolvimento.
SEED_PASSWORD=""
